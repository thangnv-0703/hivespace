{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-categories": { "ClusterId": "catalog", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/v1/categories/{**rest}" } },
      "catalog": { "ClusterId": "catalog", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/v1/catalog/{**rest}" } },
      "identity": { "ClusterId": "identity", "Match": { "Path": "/v1/identity/{**rest}" } },
      "users": { "ClusterId": "identity", "AuthorizationPolicy": "anonymous", "RateLimiterPolicy": "auth", "Match": { "Path": "/v1/users/{**rest}" } },
      "users-root": { "ClusterId": "identity", "AuthorizationPolicy": "anonymous", "RateLimiterPolicy": "auth", "Match": { "Path": "/v1/users" } },
      "connect": { "ClusterId": "identity", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/connect/{**rest}" } },
      "well-known": { "ClusterId": "identity", "AuthorizationPolicy": "anonymous", "Match": { "Path": "/.well-known/{**rest}" } },
      "order": { "ClusterId": "order", "Match": { "Path": "/v1/order/{**rest}" } },
      "payment": { "ClusterId": "payment", "Match": { "Path": "/v1/payment/{**rest}" } },
      "media": { "ClusterId": "media", "Match": { "Path": "/v1/media/{**rest}" } },
      "cart": { "ClusterId": "cart", "Match": { "Path": "/v1/cart/{**rest}" } },
      "search-ai": { "ClusterId": "search-ai", "Match": { "Path": "/v1/search-ai/{**rest}" } }
    },
    "Clusters": {
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog" } } },
      "identity": { "Destinations": { "d1": { "Address": "http://identity" } } },
      "order": { "Destinations": { "d1": { "Address": "http://order" } } },
      "payment": { "Destinations": { "d1": { "Address": "http://payment" } } },
      "media": { "Destinations": { "d1": { "Address": "http://media" } } },
      "cart": { "Destinations": { "d1": { "Address": "http://cart" } } },
      "search-ai": { "Destinations": { "d1": { "Address": "http://search-ai" } } }
    }
  }
}
