{
  "ReverseProxy": {
    "Routes": {
      "spa-seller": {
        "ClusterId": "seller-centre-dev",
        "AuthorizationPolicy": "anonymous",
        "Order": 100,
        "Match": { "Hosts": [ "seller.localhost:5080" ], "Path": "/{**rest}" }
      },
      "spa-storefront": {
        "ClusterId": "storefront-dev",
        "AuthorizationPolicy": "anonymous",
        "Order": 1000,
        "Match": { "Path": "/{**rest}" }
      }
    },
    "Clusters": {
      "storefront-dev": {
        "Destinations": {
          "d1": { "Address": "http://storefront" }
        }
      },
      "seller-centre-dev": {
        "Destinations": {
          "d1": { "Address": "http://seller-centre" }
        }
      }
    }
  }
}
