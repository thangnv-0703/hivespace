{
  "$description": "HiveSpace design tokens (W3C DTCG). Canonical source for all design values; docs/design.md embeds the same values as CSS. Primitives under color/font/space/...; semantic role tokens per theme under theme.light and theme.dark, aliasing primitives. Extracted from references/hivespace.web (Tailwind v4 build CSS); values marked with $extensions.hivespace.origin = 'template-default' were absent from the build and filled from the TailAdmin palette the reference is built on; 'added' means defined here, not in the reference.",
  "color": {
    "white": { "$type": "color", "$value": "#ffffff" },
    "brand": {
      "50": { "$type": "color", "$value": "#ecf3ff" },
      "100": { "$type": "color", "$value": "#dde9ff" },
      "200": { "$type": "color", "$value": "#c2d6ff", "$extensions": { "hivespace": { "origin": "template-default" } } },
      "300": { "$type": "color", "$value": "#9cb9ff" },
      "400": { "$type": "color", "$value": "#7592ff" },
      "500": { "$type": "color", "$value": "#465fff" },
      "600": { "$type": "color", "$value": "#3641f5" },
      "700": { "$type": "color", "$value": "#2a31d8" },
      "800": { "$type": "color", "$value": "#252dae" },
      "900": { "$type": "color", "$value": "#262e89" },
      "950": { "$type": "color", "$value": "#161950" }
    },
    "gray": {
      "50": { "$type": "color", "$value": "#f9fafb" },
      "100": { "$type": "color", "$value": "#f2f4f7" },
      "200": { "$type": "color", "$value": "#e4e7ec" },
      "300": { "$type": "color", "$value": "#d0d5dd" },
      "400": { "$type": "color", "$value": "#98a2b3" },
      "500": { "$type": "color", "$value": "#667085" },
      "600": { "$type": "color", "$value": "#475467" },
      "700": { "$type": "color", "$value": "#344054" },
      "800": { "$type": "color", "$value": "#1d2939" },
      "900": { "$type": "color", "$value": "#101828" },
      "950": { "$type": "color", "$value": "#0c111d" }
    },
    "success": {
      "50": { "$type": "color", "$value": "#ecfdf3" },
      "100": { "$type": "color", "$value": "#d1fadf" },
      "400": { "$type": "color", "$value": "#32d583" },
      "500": { "$type": "color", "$value": "#12b76a" },
      "600": { "$type": "color", "$value": "#039855" },
      "700": { "$type": "color", "$value": "#027a48" }
    },
    "error": {
      "50": { "$type": "color", "$value": "#fef3f2" },
      "100": { "$type": "color", "$value": "#fee4e2" },
      "400": { "$type": "color", "$value": "#f97066" },
      "500": { "$type": "color", "$value": "#f04438" },
      "600": { "$type": "color", "$value": "#d92d20" },
      "700": { "$type": "color", "$value": "#b42318" }
    },
    "warning": {
      "50": { "$type": "color", "$value": "#fffaeb" },
      "100": { "$type": "color", "$value": "#fef0c7" },
      "400": { "$type": "color", "$value": "#fdb022" },
      "500": { "$type": "color", "$value": "#f79009" },
      "600": { "$type": "color", "$value": "#dc6803" },
      "700": { "$type": "color", "$value": "#b54708" }
    },
    "info": {
      "50": { "$type": "color", "$value": "#f0f9ff" },
      "100": { "$type": "color", "$value": "#e0f2fe" },
      "400": { "$type": "color", "$value": "#36bffa" },
      "500": { "$type": "color", "$value": "#0ba5ec" },
      "600": { "$type": "color", "$value": "#0086c9", "$extensions": { "hivespace": { "origin": "template-default" } } },
      "700": { "$type": "color", "$value": "#026aa2" }
    }
  },
  "theme": {
    "light": {
      "bg": {
        "canvas": { "$type": "color", "$value": "{color.gray.50}", "$description": "Page background behind surfaces" },
        "surface": { "$type": "color", "$value": "{color.white}", "$description": "Cards, panels, header, inputs" },
        "subtle": { "$type": "color", "$value": "{color.gray.100}", "$description": "Hover rows, skeletons, secondary panels" },
        "overlay": { "$type": "color", "$value": "#101828b3", "$description": "Modal scrim (gray-900 at 70%)" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.gray.900}" },
        "secondary": { "$type": "color", "$value": "{color.gray.700}" },
        "muted": { "$type": "color", "$value": "{color.gray.500}", "$description": "Help text, meta, placeholders" },
        "disabled": { "$type": "color", "$value": "{color.gray.400}", "$description": "Disabled only (exempt from contrast)" },
        "on-brand": { "$type": "color", "$value": "{color.white}" },
        "link": { "$type": "color", "$value": "{color.brand.600}" },
        "link-hover": { "$type": "color", "$value": "{color.brand.700}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.gray.200}", "$description": "Dividers, card edges (decorative)" },
        "control": { "$type": "color", "$value": "{color.gray.500}", "$description": "Input/checkbox/radio boundaries; must reach 3:1 (WCAG 1.4.11)" }
      },
      "action": {
        "primary": {
          "bg": { "$type": "color", "$value": "{color.brand.500}" },
          "bg-hover": { "$type": "color", "$value": "{color.brand.600}" },
          "bg-active": { "$type": "color", "$value": "{color.brand.700}" },
          "bg-disabled": { "$type": "color", "$value": "{color.brand.300}" },
          "fg": { "$type": "color", "$value": "{color.white}" }
        },
        "secondary": {
          "bg": { "$type": "color", "$value": "{color.white}" },
          "bg-hover": { "$type": "color", "$value": "{color.gray.50}" },
          "fg": { "$type": "color", "$value": "{color.gray.700}" },
          "border": { "$type": "color", "$value": "{color.gray.300}" }
        },
        "danger": {
          "bg": { "$type": "color", "$value": "{color.error.600}" },
          "bg-hover": { "$type": "color", "$value": "{color.error.700}" },
          "fg": { "$type": "color", "$value": "{color.white}" }
        }
      },
      "feedback": {
        "success": {
          "fg": { "$type": "color", "$value": "{color.success.700}" },
          "bg": { "$type": "color", "$value": "{color.success.50}" },
          "icon": { "$type": "color", "$value": "{color.success.600}" }
        },
        "warning": {
          "fg": { "$type": "color", "$value": "{color.warning.700}" },
          "bg": { "$type": "color", "$value": "{color.warning.50}" },
          "icon": { "$type": "color", "$value": "{color.warning.600}" }
        },
        "error": {
          "fg": { "$type": "color", "$value": "{color.error.700}" },
          "bg": { "$type": "color", "$value": "{color.error.50}" },
          "icon": { "$type": "color", "$value": "{color.error.600}" }
        },
        "info": {
          "fg": { "$type": "color", "$value": "{color.info.700}" },
          "bg": { "$type": "color", "$value": "{color.info.50}" },
          "icon": { "$type": "color", "$value": "{color.info.600}" }
        }
      },
      "commerce": {
        "price": { "$type": "color", "$value": "{color.error.600}", "$description": "Sale price text" },
        "rating": { "$type": "color", "$value": "{color.warning.500}", "$description": "Star glyphs; always paired with the numeric rating as text" }
      },
      "focus-ring": { "$type": "color", "$value": "{color.brand.500}" }
    },
    "dark": {
      "bg": {
        "canvas": { "$type": "color", "$value": "{color.gray.950}" },
        "surface": { "$type": "color", "$value": "{color.gray.900}" },
        "subtle": { "$type": "color", "$value": "{color.gray.800}" },
        "overlay": { "$type": "color", "$value": "#0c111dcc", "$description": "Modal scrim (gray-950 at 80%)" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.gray.50}" },
        "secondary": { "$type": "color", "$value": "{color.gray.300}" },
        "muted": { "$type": "color", "$value": "{color.gray.400}" },
        "disabled": { "$type": "color", "$value": "{color.gray.600}" },
        "on-brand": { "$type": "color", "$value": "{color.white}" },
        "link": { "$type": "color", "$value": "{color.brand.300}" },
        "link-hover": { "$type": "color", "$value": "{color.brand.200}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.gray.800}" },
        "control": { "$type": "color", "$value": "{color.gray.500}" }
      },
      "action": {
        "primary": {
          "bg": { "$type": "color", "$value": "{color.brand.500}" },
          "bg-hover": { "$type": "color", "$value": "{color.brand.600}" },
          "bg-active": { "$type": "color", "$value": "{color.brand.700}" },
          "bg-disabled": { "$type": "color", "$value": "{color.brand.900}" },
          "fg": { "$type": "color", "$value": "{color.white}" }
        },
        "secondary": {
          "bg": { "$type": "color", "$value": "{color.gray.800}" },
          "bg-hover": { "$type": "color", "$value": "{color.gray.700}" },
          "fg": { "$type": "color", "$value": "{color.gray.200}" },
          "border": { "$type": "color", "$value": "{color.gray.700}" }
        },
        "danger": {
          "bg": { "$type": "color", "$value": "{color.error.600}" },
          "bg-hover": { "$type": "color", "$value": "{color.error.700}" },
          "fg": { "$type": "color", "$value": "{color.white}" }
        }
      },
      "feedback": {
        "success": {
          "fg": { "$type": "color", "$value": "{color.success.400}" },
          "bg": { "$type": "color", "$value": "#12b76a26", "$description": "success-500 at 15%" },
          "icon": { "$type": "color", "$value": "{color.success.400}" }
        },
        "warning": {
          "fg": { "$type": "color", "$value": "{color.warning.400}" },
          "bg": { "$type": "color", "$value": "#f7900926", "$description": "warning-500 at 15%" },
          "icon": { "$type": "color", "$value": "{color.warning.400}" }
        },
        "error": {
          "fg": { "$type": "color", "$value": "{color.error.400}" },
          "bg": { "$type": "color", "$value": "#f0443826", "$description": "error-500 at 15%" },
          "icon": { "$type": "color", "$value": "{color.error.400}" }
        },
        "info": {
          "fg": { "$type": "color", "$value": "{color.info.400}" },
          "bg": { "$type": "color", "$value": "#0ba5ec26", "$description": "info-500 at 15%" },
          "icon": { "$type": "color", "$value": "{color.info.400}" }
        }
      },
      "commerce": {
        "price": { "$type": "color", "$value": "{color.error.400}" },
        "rating": { "$type": "color", "$value": "{color.warning.400}" }
      },
      "focus-ring": { "$type": "color", "$value": "{color.brand.400}" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Outfit Variable", "Noto Sans Variable", "Segoe UI", "system-ui", "-apple-system", "sans-serif"], "$description": "Self-hosted via @fontsource-variable (base.css). Outfit has no Vietnamese subset, so Vietnamese letters with diacritics fall back to Noto Sans" },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "text": {
    "xs": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "lineHeight": "18px", "fontWeight": 400 } },
    "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 } },
    "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 }, "$extensions": { "hivespace": { "origin": "added" } } },
    "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 500 }, "$extensions": { "hivespace": { "origin": "added" } } },
    "xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "lineHeight": "30px", "fontWeight": 600 } },
    "title-sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "30px", "lineHeight": "38px", "fontWeight": 600 } },
    "title-md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "36px", "lineHeight": "44px", "fontWeight": 600 } },
    "title-lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "48px", "lineHeight": "60px", "fontWeight": 700 } },
    "title-2xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "72px", "lineHeight": "90px", "fontWeight": 700 } }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "xl": { "$type": "dimension", "$value": "12px" },
    "2xl": { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "size": {
    "control-sm": { "$type": "dimension", "$value": "36px", "$description": "Dense controls (SEL tables, filters); desktop only", "$extensions": { "hivespace": { "origin": "added" } } },
    "control-md": { "$type": "dimension", "$value": "44px", "$description": "Default control height and minimum touch target", "$extensions": { "hivespace": { "origin": "added" } } },
    "container": { "$type": "dimension", "$value": "1440px" },
    "header-stf": { "$type": "dimension", "$value": "80px", "$description": "Storefront header: one 80px row (logo, search, actions, cart)", "$extensions": { "hivespace": { "origin": "added" } } },
    "header-sel": { "$type": "dimension", "$value": "72px", "$extensions": { "hivespace": { "origin": "added" } } },
    "sidebar-sel": { "$type": "dimension", "$value": "260px", "$description": "Expanded; collapsed is 90px. 260 matches the reference seller app (AppSidebar lg:w-[260px])", "$extensions": { "hivespace": { "origin": "measured" } } },
    "sidebar-sel-collapsed": { "$type": "dimension", "$value": "90px", "$extensions": { "hivespace": { "origin": "template-default" } } }
  },
  "shadow": {
    "xs": { "$type": "shadow", "$value": [{ "color": "#1018280d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "sm": { "$type": "shadow", "$value": [{ "color": "#1018281a", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }, { "color": "#1018280f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "md": { "$type": "shadow", "$value": [{ "color": "#1018281a", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" }, { "color": "#1018280f", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px" }], "$extensions": { "hivespace": { "origin": "template-default" } } },
    "lg": { "$type": "shadow", "$value": [{ "color": "#10182814", "offsetX": "0px", "offsetY": "12px", "blur": "16px", "spread": "-4px" }, { "color": "#10182808", "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-2px" }] },
    "focus": { "$type": "shadow", "$value": [{ "color": "#465fff40", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "4px" }], "$description": "Soft halo shown with the 2px focus ring on inputs" }
  },
  "breakpoint": {
    "2xsm": { "$type": "dimension", "$value": "375px" },
    "xsm": { "$type": "dimension", "$value": "425px" },
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" },
    "2xl": { "$type": "dimension", "$value": "1536px" }
  },
  "z": {
    "raised": { "$type": "number", "$value": 1 },
    "sticky": { "$type": "number", "$value": 40 },
    "dropdown": { "$type": "number", "$value": 999 },
    "modal": { "$type": "number", "$value": 9999 },
    "toast": { "$type": "number", "$value": 99999 }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "150ms", "$extensions": { "hivespace": { "origin": "added" } } },
    "base": { "$type": "duration", "$value": "200ms", "$extensions": { "hivespace": { "origin": "added" } } },
    "slow": { "$type": "duration", "$value": "300ms", "$extensions": { "hivespace": { "origin": "added" } } }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$extensions": { "hivespace": { "origin": "added" } } }
  }
}
