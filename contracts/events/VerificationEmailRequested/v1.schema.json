{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivespace.dev/events/VerificationEmailRequested/v1.schema.json",
  "title": "VerificationEmailRequested v1 (producer: identity). verificationToken must never be logged (R-6).",
  "type": "object",
  "required": ["userId", "email", "displayName", "language", "verificationToken", "verificationTokenExpiresAt"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "maxLength": 254 },
    "displayName": { "type": "string", "maxLength": 80 },
    "language": { "type": "string", "enum": ["vi", "en"] },
    "verificationToken": { "type": "string", "minLength": 1 },
    "verificationTokenExpiresAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
