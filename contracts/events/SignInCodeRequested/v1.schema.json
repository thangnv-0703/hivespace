{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivespace.dev/events/SignInCodeRequested/v1.schema.json",
  "title": "SignInCodeRequested v1 (producer: identity). code must never be logged (R-6, NFR-SEC-016).",
  "type": "object",
  "required": ["userId", "email", "displayName", "language", "code", "expiresAt"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "maxLength": 254 },
    "displayName": { "type": "string", "maxLength": 80 },
    "language": { "type": "string", "enum": ["vi", "en"] },
    "code": { "type": "string", "pattern": "^[0-9]{6}$" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
