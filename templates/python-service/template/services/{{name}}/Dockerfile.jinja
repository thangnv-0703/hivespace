# Build context: repository root (needs libs/python). Example:
#   docker build -f services/{{ name }}/Dockerfile .
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /src
COPY libs/python ./libs/python
COPY services/{{ name }} ./services/{{ name }}
WORKDIR /src/services/{{ name }}
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm
WORKDIR /app
COPY --from=build /src/services/{{ name }}/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"
USER nobody
CMD ["uvicorn", "{{ module }}.main:app", "--host", "0.0.0.0", "--port", "8000"]
