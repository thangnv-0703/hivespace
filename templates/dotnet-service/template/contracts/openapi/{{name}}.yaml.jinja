openapi: 3.1.0
info:
  title: HiveSpace {{ pascal }} API
  version: 1.0.0
  description: Template sample only. The first feature slice replaces the ping operation.
servers:
  - url: /
tags:
  - name: {{ name }}
paths:
  /v1/{{ name }}/ping:
    get:
      operationId: ping{{ pascal }}
      summary: Template sample operation.
      tags: [{{ name }}]
      security: []
      responses:
        '200':
          description: The service answers.
          content:
            application/json:
              schema:
                type: object
                required: [service]
                properties:
                  service:
                    type: string
