using NetArchTest.Rules;
using Xunit;

namespace {{ pascal }}.Tests;

/// <summary>Rich shape: Domain references no framework, vendor or outer layer (repo-structure §4.1).</summary>
public sealed class LayerRulesTests
{
    [Fact]
    public void Domain_is_pure()
    {
        var result = Types.InAssembly(typeof({{ pascal }}.Domain.DomainMarker).Assembly)
            .ShouldNot()
            .HaveDependencyOnAny(
                "Microsoft.EntityFrameworkCore", "Microsoft.AspNetCore", "Npgsql", "Grpc", "Azure",
                "{{ pascal }}.Application", "{{ pascal }}.Infrastructure", "{{ pascal }}.Api")
            .GetResult();

        Assert.True(result.IsSuccessful, string.Join(", ", result.FailingTypeNames ?? []));
    }

    [Fact]
    public void Application_does_not_depend_on_infrastructure_or_api()
    {
        var result = Types.InAssembly(typeof({{ pascal }}.Application.ApplicationMarker).Assembly)
            .ShouldNot()
            .HaveDependencyOnAny("Microsoft.EntityFrameworkCore", "{{ pascal }}.Infrastructure", "{{ pascal }}.Api")
            .GetResult();

        Assert.True(result.IsSuccessful, string.Join(", ", result.FailingTypeNames ?? []));
    }
}
